{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the Sovare HQ main window. Only listed commands are callable.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "notification:default",
    "dialog:allow-ask",
    "dialog:allow-confirm",
    "dialog:allow-message",
    "allow-db-open",
    "allow-db-select",
    "allow-db-execute",
    "allow-db-batch",
    "allow-db-exec-script",
    "allow-db-backup",
    "allow-db-restore",
    "allow-secret-set",
    "allow-secret-delete",
    "allow-secret-status",
    "allow-http-secure",
    "allow-http-public",
    "allow-fs-pick-root",
    "allow-fs-list-roots",
    "allow-fs-remove-root",
    "allow-fs-scan-root",
    "allow-reveal-path",
    "allow-open-in-editor",
    "allow-open-url",
    "allow-save-file",
    "allow-attach-file",
    "allow-open-attachment",
    "allow-pick-text-file",
    "allow-app-info",
    "allow-tray-update"
  ]
}
